# Copy this file to backend/.env. Never commit real secrets.
# Root .env.example is the canonical template.

NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
AUTH_JWT_SECRET=
AUTH_PASSWORD_MIN_LENGTH=10
MONGODB_URI=mongodb://127.0.0.1:27017/seu_aims
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/seu_aims_test
REDIS_URL=redis://127.0.0.1:6379
FILE_STORAGE_DRIVER=local_dev
FILE_STORAGE_LOCAL_PATH=.local-storage
EMAIL_PROVIDER=noop
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_API_VERSION=v21.0
MALWARE_SCANNER_PROVIDER=noop
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
WHATSAPP_CLOUD_API_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_APP_SECRET=
PROVIDER_TIMEOUT_MS=10000
AUDIT_RETENTION_DAYS=0
