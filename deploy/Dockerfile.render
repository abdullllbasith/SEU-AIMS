# Single-origin image for Render: API + built frontend in one service.
FROM node:20.18.1-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN npm ci
COPY frontend ./frontend
RUN npm run build -w frontend

FROM node:20.18.1-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN npm ci --omit=dev -w backend

FROM node:20.18.1-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV FRONTEND_DIST=/app/frontend/dist
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --from=deps --chown=node:node /app/backend/node_modules ./backend/node_modules
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node backend ./backend
COPY --from=build --chown=node:node /app/frontend/dist ./frontend/dist
# Persistent disk mount point; Render mounts the disk over this path (root-owned), so run as root for write access.
RUN mkdir -p /var/data
CMD ["node", "backend/src/server/api-server.js"]
