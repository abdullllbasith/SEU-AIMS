# Copy to .env locally. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=/api

# Auth — never commit real secrets
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_RESET_TTL_SECONDS=1800
AUTH_PASSWORD_MIN_LENGTH=10
# MongoDB must be a replica set for batch progression (multi-document transactions).
# Atlas and local replica-set URIs work. Standalone mongod without replSet fails progression at runtime.
# MONGODB_URI=mongodb://127.0.0.1:27017/seu_aims?replicaSet=rs0
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/seu_aims_test?replicaSet=rs0

# Redis / job queue
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_PREFIX=seu-aims:queue

# Reverse proxy hops. Set 0 if the API is not behind a proxy.
TRUST_PROXY=1

# Mongo connection pool
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Object / file storage
# local_dev is for development only. Production must use object storage.
FILE_STORAGE_DRIVER=local_dev
FILE_STORAGE_LOCAL_PATH=.local-storage
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=

# Email provider (adapter in infrastructure; vendor is not a business rule)
# EMAIL_PROVIDER=smtp sends through SMTP (nodemailer). With noop, or without SMTP_HOST and EMAIL_FROM,
# email notifications are recorded as FAILED (not_configured); they are never reported as sent.
EMAIL_PROVIDER=noop
EMAIL_FROM=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Meta WhatsApp Cloud API (infrastructure adapter only)
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_APP_SECRET=
# Names of APPROVED Meta message templates. CA exam messages are business-initiated, so they are sent only
# as templates and never as plain text. An empty name means FAILED (whatsapp_template_not_configured).
# Body variables are listed in backend/src/modules/ca-recovery/services/exam-messages.js.
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_CA_EXAM_SCHEDULED=
WHATSAPP_TEMPLATE_CA_EXAM_RESCHEDULED=
WHATSAPP_TEMPLATE_CA_EXAM_CANCELLED=
WHATSAPP_TEMPLATE_CA_REMINDER=
PROVIDER_TIMEOUT_MS=10000

# Audit retention in days. 0 means not configured — do not auto-delete.
AUDIT_RETENTION_DAYS=0

# Malware scanner (adapter; vendor is not fixed).
# noop never marks a file clean. dev_trust is local development only and is refused in production.
MALWARE_SCANNER_PROVIDER=noop
FILE_MAX_BYTES=20971520
MALWARE_SCANNER_URL=
MALWARE_SCANNER_API_KEY=

# Request limits
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
NOTIFICATION_RETRY_MAX=5
# How often the worker releases due reminders and recovers stuck deliveries (ms), and how long a delivery lease lasts (ms).
NOTIFICATION_SWEEP_INTERVAL_MS=30000
NOTIFICATION_LEASE_MS=120000
NOTIFICATION_DEFAULT_LOCALE=en
TZ=Asia/Colombo


# Study Agent AI provider (adapter). noop = AI features report unavailable; dev_mock = tests/offline only, refused in production.
# gemini needs GEMINI_API_KEY (keep it on the server only; never expose it to the frontend).
AI_PROVIDER=noop
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_REASONING=gemini-3.1-flash-lite
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=2048
# Study Agent limits (per student).
STUDY_AGENT_MSGS_PER_MINUTE=12
STUDY_AGENT_DAILY_REQUESTS=200
STUDY_AGENT_MAX_MESSAGE_CHARS=4000
STUDY_AGENT_RETRIEVAL_TOP_K=6
STUDY_AGENT_CONTEXT_CHAR_BUDGET=8000
STUDY_AGENT_HISTORY_MESSAGES=12
# Lecturer and Admin assistants (read-only)
STAFF_AGENT_MSGS_PER_MINUTE=10
STAFF_AGENT_DAILY_REQUESTS=150
STAFF_AGENT_MAX_MESSAGE_CHARS=2000
STAFF_AGENT_HISTORY_MESSAGES=6
STAFF_AGENT_MAX_TOOLS=3
STAFF_AGENT_TOOL_CHAR_BUDGET=6000
