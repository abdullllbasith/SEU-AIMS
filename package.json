{
  "name": "seu-aims",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Department-level VLE/LMS (scalable modular monolith)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:worker": "npm run worker -w backend",
    "dev:web": "npm run dev -w frontend",
    "start:api": "npm run start -w backend",
    "start:worker": "npm run start:worker -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "test:unit": "npm run test:unit -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:security": "npm run test:security -w backend",
    "test:smoke": "npm run test:smoke -w backend",
    "build": "npm run build -w frontend",
    "check:bundle": "node scripts/check-frontend-bundle.js",
    "ci": "npm run check:secrets && npm run test:unit && npm run test:integration && npm run test:security && npm run test:frontend && npm run build && npm run check:bundle",
    "audit:prod": "npm audit --omit=dev",
    "check:secrets": "node scripts/check-secrets.js",
    "seed": "npm run seed -w backend"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
